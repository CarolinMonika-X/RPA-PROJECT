{
  "id": "wf_button_inspection",
  "name": "Button Detection & Visual Inspection",
  "description": "Captures current desktop, runs multi-scale template matching, and reports detection coordinates without clicking.",
  "steps": [
    {
      "id": "step_capture",
      "type": "screenshot",
      "name": "Capture Desktop Screen",
      "params": {
        "label": "inspection_screen"
      },
      "timeout_seconds": 10.0,
      "retry_count": 1,
      "continue_on_failure": false
    },
    {
      "id": "step_detect",
      "type": "image_detection",
      "name": "Locate Save Button Template",
      "params": {
        "template_name": "save_employee.png",
        "threshold": 0.8,
        "multi_scale": true
      },
      "timeout_seconds": 10.0,
      "retry_count": 1,
      "continue_on_failure": false
    }
  ],
  "version": "2.0",
  "created_at": "2026-10-28T21:16:56.655758",
  "updated_at": "2026-10-28T21:16:56.655758"
}